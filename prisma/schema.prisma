// CleanCheck - SaaS Platform for Cleaning Companies
// Database Schema - SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// COMPANY - Cleaning company tenant
// ============================================================================
model Company {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  subscriptionTier         String   @default("free") // free, pro, enterprise
  maxAgents                Int      @default(3)
  maxInterventionsPerMonth Int      @default(30)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  users              User[]
  clients            Client[]
  interventions      Intervention[]
  checklistTemplates ChecklistTemplate[]
  qualityScores      QualityScore[]

  @@index([slug])
  @@index([subscriptionTier])
}

// ============================================================================
// USER - Multi-role users (manager, agent, client)
// ============================================================================
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  passwordHash String
  firstName   String
  lastName    String
  phone       String?
  role        String    @default("agent") // manager, agent, client
  companyId   String?
  avatarUrl   String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions Intervention[]  @relation("AgentInterventions")
  ratings       Rating[]        @relation("UserRatings")
  qualityScores QualityScore[]  @relation("AgentScores")
  sessions      Session[]

  @@index([email])
  @@index([role])
  @@index([companyId])
  @@index([isActive])
}

// ============================================================================
// CLIENT - End customers of cleaning interventions
// ============================================================================
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  notes     String?
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions Intervention[]
  ratings       Rating[]       @relation("ClientRatings")

  @@index([companyId])
  @@index([city])
}

// ============================================================================
// INTERVENTION - Cleaning service intervention
// ============================================================================
model Intervention {
  id                  String    @id @default(cuid())
  companyId           String
  clientId            String
  agentId             String
  checklistTemplateId String?
  status              String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?

  // QR Code fields
  qrToken       String    @unique
  qrPinCode     String
  qrGeneratedAt DateTime  @default(now())
  qrExpiresAt   DateTime
  qrScannedAt   DateTime?
  qrCompletedAt DateTime?
  qrUsed        Boolean   @default(false)

  notes            String?
  clientReportUrl  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent             User              @relation("AgentInterventions", fields: [agentId], references: [id])
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])
  checklistItems    ChecklistItem[]
  rating            Rating?

  @@index([companyId])
  @@index([clientId])
  @@index([agentId])
  @@index([status])
  @@index([scheduledStart])
  @@index([qrToken])
}

// ============================================================================
// CHECKLIST TEMPLATE - Reusable checklist definitions
// ============================================================================
model ChecklistTemplate {
  id                       String    @id @default(cuid())
  name                     String
  description              String?
  companyId                String
  itemsJson                String    // JSON string of array
  estimatedDurationMinutes Int       @default(30)
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@index([companyId])
  @@index([isActive])
}

// ============================================================================
// CHECKLIST ITEM - Individual task within an intervention
// ============================================================================
model ChecklistItem {
  id             String    @id @default(cuid())
  interventionId String
  taskName       String
  description    String?
  completed      Boolean   @default(false)
  notes          String?
  photoUrl       String?
  completedAt    DateTime?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())

  // Relations
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
}

// ============================================================================
// RATING - Client satisfaction rating for interventions
// ============================================================================
model Rating {
  id             String   @id @default(cuid())
  interventionId String   @unique
  clientName     String?
  clientEmail    String?
  score          Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  // Relations
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  agent         User        @relation("UserRatings", fields: [agentId], references: [id])
  agentId       String
  client        Client      @relation("ClientRatings", fields: [clientId], references: [id])
  clientId      String

  @@index([interventionId])
  @@index([score])
  @@index([agentId])
  @@index([clientId])
}

// ============================================================================
// QUALITY SCORE - Agent performance scoring
// ============================================================================
model QualityScore {
  id                 String    @id @default(cuid())
  agentId            String
  companyId          String
  score              Float     // 0-100
  punctualityScore   Float
  completionScore    Float
  clientRatingScore  Float
  regularityScore    Float
  reactivityScore    Float
  interventionCount  Int       @default(0)
  calculatedAt       DateTime  @default(now())
  createdAt          DateTime  @default(now())

  // Relations
  agent   User    @relation("AgentScores", fields: [agentId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([companyId])
  @@index([calculatedAt])
}

// ============================================================================
// SESSION - Custom JWT auth sessions
// ============================================================================
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}
