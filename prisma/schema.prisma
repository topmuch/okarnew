// CleanCheck - SaaS Platform for Cleaning Companies
// Database Schema - SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// COMPANY - Cleaning company tenant
// ============================================================================
model Company {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  subscriptionTier         String   @default("free") // free, pro, enterprise
  maxAgents                Int      @default(3)
  maxInterventionsPerMonth Int      @default(30)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  users              User[]
  clients            Client[]
  interventions      Intervention[]
  checklistTemplates ChecklistTemplate[]
  qualityScores      QualityScore[]
  subscriptions      Subscription[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]

  @@index([slug])
  @@index([subscriptionTier])
}

// ============================================================================
// USER - Multi-role users (manager, agent, client)
// ============================================================================
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  passwordHash String
  firstName   String
  lastName    String
  phone       String?
  role        String    @default("agent") // manager, agent, client
  companyId   String?
  avatarUrl   String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions Intervention[]  @relation("AgentInterventions")
  ratings       Rating[]        @relation("UserRatings")
  qualityScores QualityScore[]  @relation("AgentScores")
  sessions         Session[]
  auditLogs         AuditLog[]              @relation("SuperAdminAuditLogs")
  supportTickets    SupportTicket[]         @relation("UserTickets")
  ticketMessages    TicketMessage[]
  resolvedTickets   SupportTicket[]         @relation("AssignedTickets")

  @@index([email])
  @@index([role])
  @@index([companyId])
  @@index([isActive])
}

// ============================================================================
// CLIENT - End customers of cleaning interventions
// ============================================================================
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  notes     String?
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions Intervention[]
  ratings       Rating[]       @relation("ClientRatings")

  @@index([companyId])
  @@index([city])
}

// ============================================================================
// INTERVENTION - Cleaning service intervention
// ============================================================================
model Intervention {
  id                  String    @id @default(cuid())
  companyId           String
  clientId            String
  agentId             String
  checklistTemplateId String?
  status              String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?

  // QR Code fields
  qrToken       String    @unique
  qrPinCode     String
  qrGeneratedAt DateTime  @default(now())
  qrExpiresAt   DateTime
  qrScannedAt   DateTime?
  qrCompletedAt DateTime?
  qrUsed        Boolean   @default(false)

  notes            String?
  clientReportUrl  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent             User              @relation("AgentInterventions", fields: [agentId], references: [id])
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])
  checklistItems    ChecklistItem[]
  rating            Rating?

  @@index([companyId])
  @@index([clientId])
  @@index([agentId])
  @@index([status])
  @@index([scheduledStart])
  @@index([qrToken])
}

// ============================================================================
// CHECKLIST TEMPLATE - Reusable checklist definitions
// ============================================================================
model ChecklistTemplate {
  id                       String    @id @default(cuid())
  name                     String
  description              String?
  companyId                String
  itemsJson                String    // JSON string of array
  estimatedDurationMinutes Int       @default(30)
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@index([companyId])
  @@index([isActive])
}

// ============================================================================
// CHECKLIST ITEM - Individual task within an intervention
// ============================================================================
model ChecklistItem {
  id             String    @id @default(cuid())
  interventionId String
  taskName       String
  description    String?
  completed      Boolean   @default(false)
  notes          String?
  photoUrl       String?
  completedAt    DateTime?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())

  // Relations
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
}

// ============================================================================
// RATING - Client satisfaction rating for interventions
// ============================================================================
model Rating {
  id             String   @id @default(cuid())
  interventionId String   @unique
  clientName     String?
  clientEmail    String?
  score          Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  // Relations
  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  agent         User        @relation("UserRatings", fields: [agentId], references: [id])
  agentId       String
  client        Client      @relation("ClientRatings", fields: [clientId], references: [id])
  clientId      String

  @@index([interventionId])
  @@index([score])
  @@index([agentId])
  @@index([clientId])
}

// ============================================================================
// QUALITY SCORE - Agent performance scoring
// ============================================================================
model QualityScore {
  id                 String    @id @default(cuid())
  agentId            String
  companyId          String
  score              Float     // 0-100
  punctualityScore   Float
  completionScore    Float
  clientRatingScore  Float
  regularityScore    Float
  reactivityScore    Float
  interventionCount  Int       @default(0)
  calculatedAt       DateTime  @default(now())
  createdAt          DateTime  @default(now())

  // Relations
  agent   User    @relation("AgentScores", fields: [agentId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([companyId])
  @@index([calculatedAt])
}

// ============================================================================
// SESSION - Custom JWT auth sessions
// ============================================================================
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// SUBSCRIPTION - Stripe-backed subscription management
// ============================================================================
model Subscription {
  id                   String    @id @default(cuid())
  companyId            String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String    @default("free") // free, starter, pro, enterprise
  status               String    @default("trialing") // trialing, active, past_due, canceled, unpaid, paused
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  stripePriceId        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([companyId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([plan])
}

// ============================================================================
// INVOICE - Stripe invoice records
// ============================================================================
model Invoice {
  id              String    @id @default(cuid())
  companyId       String
  stripeInvoiceId String    @unique
  amount          Float
  currency        String    @default("eur")
  status          String    @default("draft") // draft, open, paid, uncollectible, void
  hostedUrl       String?
  pdfUrl          String?
  description     String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId  String

  @@index([companyId])
  @@index([stripeInvoiceId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// AUDIT LOG - Immutable audit trail for superadmin actions
// ============================================================================
model AuditLog {
  id           String   @id @default(cuid())
  superAdminId String
  companyId    String?
  action       String   // create, update, delete, login, impersonate_start, impersonate_end, config_change, flag_toggle, support_action
  targetType   String   // company, user, subscription, invoice, config, feature_flag, support_ticket, rating
  targetId     String?
  before       String?  // JSON string of previous state
  after        String?  // JSON string of new state
  ipAddress    String?
  userAgent    String?
  metadata     String?  // Additional context as JSON
  createdAt    DateTime @default(now())

  // Relations
  superAdmin User     @relation("SuperAdminAuditLogs", fields: [superAdminId], references: [id], onDelete: Restrict)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([superAdminId])
  @@index([companyId])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([createdAt])
  @@index([ipAddress])
}

// ============================================================================
// PLATFORM CONFIG - Key-value system configuration
// ============================================================================
model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  label     String   // Human-readable label
  category  String   // scoring, qr, email, sms, storage, general
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([category])
  @@index([key])
}

// ============================================================================
// FEATURE FLAG - Toggle features globally or per plan/role
// ============================================================================
model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(true)
  targetType  String   @default("global") // global, plan, role
  targetValue String?  // e.g. "pro,enterprise" or "manager,superadmin"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isEnabled])
  @@index([targetType])
}

// ============================================================================
// SUPPORT TICKET - Support queue for platform issues
// ============================================================================
model SupportTicket {
  id          String    @id @default(cuid())
  companyId   String?
  userId      String?   // User who created the ticket
  subject     String
  description String
  status      String    @default("open") // open, in_progress, waiting, resolved, closed
  priority    String    @default("normal") // low, normal, high, urgent
  assignedTo  String?   // SuperAdmin user ID
  resolution  String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user        User?          @relation("UserTickets", fields: [userId], references: [id], onDelete: SetNull)
  assignedToUser User?        @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
}

// ============================================================================
// TICKET MESSAGE - Messages within support tickets
// ============================================================================
model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?  // Who wrote the message (superadmin or company user)
  isAdmin   Boolean  @default(false) // true if written by superadmin
  content   String
  createdAt DateTime @default(now())

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
}
